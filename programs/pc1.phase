# PC1 — обратимое ARX-ядро (12 раундов), чисто обратимое.
# Блок r0..r3 (256 бит), ключ r4..r7 (256 бит, только источники), счётчик r8.
#
#   encrypt: phase-vm run programs/pc1.phase --regs 16 \
#              --set r0=<pt0> r1=<pt1> r2=<pt2> r3=<pt3> \
#              --set r4=<k0> r5=<k1> r6=<k2> r7=<k3> --set r8=0
#   decrypt: phase-vm runrev programs/pc1.phase --regs 16 \
#              --set r0=<ct0> r1=<ct1> r2=<ct2> r3=<ct3> \
#              --set r4=<k0> r5=<k1> r6=<k2> r7=<k3> --set r8=12
# Удобнее: phase-vm cipher --key <hex64> --pt <hex64> --rounds 12
rep 12
  xor r0 r8
  add r0 r1
  rotl r1 17
  xor r1 r0
  add r2 r3
  rotl r3 13
  xor r3 r2
  add r0 r2
  rotl r2 9
  xor r2 r0
  add r1 r3
  rotl r3 5
  xor r3 r1
  add r0 r4
  add r1 r5
  add r2 r6
  add r3 r7
  inc r8
end
