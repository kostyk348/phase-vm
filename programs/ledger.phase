# Транзакция-перевод A→B в памяти (двойная запись, обратимое ядро между границами).
# Аналог #11: «при отказе транзакции система делает обратный шаг F⁻¹ в памяти».
#
#   phase-vm run programs/ledger.phase --mem 8   → A=993, B=507
#   phase-vm rev programs/ledger.phase --mem 8   → откат: A=1000, B=500 (ввод цел)
#   phase-vm dbg programs/ledger.phase --mem 8   → пошагово f/b
set r0 1        # адрес счёта A (mem[1])
set r1 2        # адрес счёта B (mem[2])
mset 1 1000     # граница: A = 1000
mset 2 500      # граница: B = 500
set r2 7        # сумма перевода (источник — не уничтожается)
msub r0 r2      # A -= 7     (ядро: обратимо)
madd r1 r2      # B += 7     (ядро: обратимо)
